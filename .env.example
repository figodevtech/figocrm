# Supabase Client & Server Environment Variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct PostgreSQL Connection
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
DATABASE_DIRECT_CONNECTION_STRING=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
DATABASE_PASSWORD=your-password

# Asaas Checkout recorrente (cartão). Configure webhook para /api/webhooks/payment.
BILLING_PROVIDER=asaas
ASAAS_API_BASE_URL=https://api-sandbox.asaas.com/v3
# Chave do sandbox começa com $aact_hmlg_. A chave de produção ($aact_prod_) usa https://api.asaas.com/v3.
# Em .env.local, escape o $ inicial da chave (\$aact_...) para o carregador do Next preservar o valor.
ASAAS_API_KEY=your-asaas-api-key
ASAAS_WEBHOOK_TOKEN=your-dedicated-webhook-token
NEXT_PUBLIC_APP_URL=http://localhost:3000
